<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="work_place_tree_view" model="ir.ui.view">
            <field name="name">work.place.tree.view</field>
            <field name="model">work.place</field>
            <field name="arch" type="xml">
                <tree string="Work Place Tree">
                    <field name="name"/>
                    <field name="tag_id"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="work_place_form_view">
            <field name="name">work.place.form</field>
            <field name="model">work.place</field>
            <field name="arch" type="xml">
                <form string="Work Place Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="tag_id" required="True"/>
                                <field name="name" required="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Sub Work Places">
                                <field name="work_places_ids">
                                    <tree>
                                        <field name="name" required="True"/>
                                        <field name="code" required="True"/>
                                    </tree>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="name" required="True"/>
                                            </group>
                                            <group>
                                                <field name="code" required="True"/>
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>


        <record id="mehan_year_finance_tree_view" model="ir.ui.view">
            <field name="name">mehan.year.finance.tree.view</field>
            <field name="model">mehan.year.finance</field>
            <field name="arch" type="xml">
                <tree string="Year Finance Tree">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="mehan_year_finance_form_view">
            <field name="name">mehan.year.finance.form</field>
            <field name="model">mehan.year.finance</field>
            <field name="arch" type="xml">
                <form string="Year Finance Form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Name"/>
                            <h1>
                                <field name="name" required="True"/>
                            </h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="work_place_tag_tree_view" model="ir.ui.view">
            <field name="name">work.place.tag.tree.view</field>
            <field name="model">work.place.tag</field>
            <field name="arch" type="xml">
                <tree string="Work Place Tag Tree">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="work_place_tag_form_view">
            <field name="name">work.place.tag.form</field>
            <field name="model">work.place.tag</field>
            <field name="arch" type="xml">
                <form string="Work Place Tag Form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Tag"/>
                            <h1>
                                <field name="name" required="True"/>
                            </h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="work_place_lines_tree_view" model="ir.ui.view">
            <field name="name">work.place.lines.tree.view</field>
            <field name="model">work.place.lines</field>
            <field name="arch" type="xml">
                <tree string="Work Place Lines Tree" create="0">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="place_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="work_place_lines_form_view">
            <field name="name">work.place.lines.form</field>
            <field name="model">work.place.lines</field>
            <field name="arch" type="xml">
                <form string="Work Place Lines Form">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="place_id" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="work_place_action_window">
            <field name="name">Work Place</field>
            <field name="res_model">work.place</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window" id="mehan_year_finance_action_window">
            <field name="name">Year Finance</field>
            <field name="res_model">mehan.year.finance</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window" id="work_place_tag_action_window">
            <field name="name">Work Place Tag</field>
            <field name="res_model">work.place.tag</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window" id="work_place_lines_action_window">
            <field name="name">Work Place Lines</field>
            <field name="res_model">work.place.lines</field>
            <field name="view_mode">tree,form</field>
        </record>


        <menuitem name="Work Places" id="work_place_menu" parent="mehan_configurations_menu"
                  action="work_place_action_window"/>

        <menuitem name="Year Finance" id="mehan_year_finance_menu" parent="mehan_configurations_menu"
                  action="mehan_year_finance_action_window"/>

        <menuitem name="Work Place Tags" id="work_place_tag_menu" parent="mehan_configurations_menu"
                  action="work_place_tag_action_window"/>

        <menuitem name="Work Place Lines" id="work_place_lines_menu" parent="mehan_configurations_menu"
                  action="work_place_lines_action_window"/>


    </data>
</odoo>