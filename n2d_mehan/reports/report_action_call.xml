<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<report
		id="action_beneficiary_disbursement_permission"
		string="إذن صرف المستفيد"
		model="beneficiary.disbursement.permission"
		report_type="qweb-pdf"
		file="n2d_mehan.beneficiary_disbursement_permission_template"
		name="n2d_mehan.beneficiary_disbursement_permission_template"
		/>


	<report 
		id="action_report_mehan_order_payment"
		string="Payment Note"
		model="mehan.order.payment"
		report_type="qweb-pdf"
		file="n2d_mehan.report_mehan_order_payment"
		name="n2d_mehan.report_mehan_order_payment"
		print_report_name="'Payment Note -%s' %(object.deceased_id.name)"/>

		 <report
                id="death_beneficiaries_lines_report"
                model="death.beneficiaries.lines"
                string="beneficiary report"
                report_type="qweb-pdf"
                name="n2d_mehan.death_beneficiaries_lines_report_template"
                file="n2d_mehan.death_beneficiaries_lines_report_template"
				menu="False"
        />

        <record id="paperformat_action_report_mehan_order_payment" model="report.paperformat">
            <field name="name">Payment Note</field>
			<field name="default" eval="True" />
			<field name="format">A4</field>
			<field name="page_height">0</field>
			<field name="page_width">0</field>
			<field name="orientation">Portrait</field>
			<field name="margin_top">100</field>
			<field name="margin_bottom">10</field>
			<field name="margin_left">5</field>
			<field name="margin_right">5</field>
			<field name="header_line" eval="False" />
			<field name="header_spacing">95</field>
			<field name="dpi">90</field>
            <field name="report_ids" eval="[(6,0,[ref('n2d_mehan.action_report_mehan_order_payment'),ref('n2d_mehan.death_beneficiaries_lines_report'),ref('n2d_mehan.action_beneficiary_disbursement_permission')])]"/>
        </record>

	</data>
</odoo>