<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="external_layout_seti">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <div class="header" style="font-family: 'Droid Arabic Naskh'; font-weight: bold;background-color:#f2f7f2;">
            <div style="width:100%; background-color:#f2f7f2; direction:rtl; padding:10px;">
                <div style="width:30%;text-align:center;">
                    <strong>رئاسة مجلس الوزراء</strong>
                </div>
                <div style="width:40%;text-align:center;">
                    <strong>صندوق التعويض عن مخاطر المهن الطبية</strong>
                </div>
                <div style="width:30%;text-align:center;">
                    <strong>المدير التنفيذى</strong>
                </div>
            </div>
            <div class="row" style="margin-top:5px;dir:rtl;margin-bottom:10px;margin-left:10px;">
                <div class="col-1" style="text-align:center;">
                    <span>رقم</span>
                </div>
                <div class="col-3" style="text-align:center;">
                    <span t-esc="o.name"/>
                </div>
                <div class="col-6" style="text-align:center;">
                    <h4 style="text-decoration: underline;">مذكرة صرف</h4>
                </div>
                <div class="col-2" style="text-align:center;">
                    <t t-if="o.member_type == 'dead'">
                        <span>متوفى</span>
                    </t>
                    <t t-if="o.member_type == 'injured'">
                        <span>مصاب</span>
                    </t>
                </div>
            </div>
            <div style="direction:rtl; text-align:right;">
                <table style="width:100%;margin-bottom:5px;">
                    <tbody>
                        <tr>
                            <td style="width:13%;">
                                <span>رقم الـ 55 ع ح :</span>
                            </td>
                            <td style="padding:3px; border:1px solid #858c97;width:22%;">
                                <span t-esc="o.deceased_id.no_55"/>
                            </td>
                            <td style="width:15%;">
                                <span>تاريـخ الـ 55 ع ح :</span>
                            </td>
                            <td style="padding:3px; border:1px solid #858c97;width:20%;">
                                <span t-esc="o.deceased_id.date_55"/>
                            </td>
                            <td style="width:5%;">
                            </td>
                            <td style="padding:3px;width:20%;">
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table style="width:100%;margin-bottom:5px;">
                    <tbody>
                        <tr>
                            <td style="width:18%;">
                                <span>رقم الـ 224 ع ح:</span>
                            </td>
                            <td style="padding:3px; border:1px solid #858c97;width:20%;">
                                <span t-esc="o.deceased_id.no_224"/>
                            </td>
                            <td style="width:18%;">
                                <span>تاريـخ الـ 224 ع ح:</span>
                            </td>
                            <td style="padding:3px; border:1px solid #858c97;width:20%;">
                                <span t-esc="o.deceased_id.date_224"/>
                            </td>
                            <td style="width:12%;">
                            </td>
                            <td style="padding:3px;width:10%;">
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table style="width:100%;margin-bottom:5px;">
                    <tbody>
                        <tr>
                            <td style="width:10%;">
                                <span>نوع الصرف</span>
                            </td>
                            <td style="padding:3px; border:1px solid #858c97;width:25%;">
                                <span t-esc="o.deceased_id.expense_type_id.name"/>
                            </td>
                            <td style="width:15%;">
                                <span>مؤيد الصرف</span>
                            </td>
                            <td style="padding:3px; border:1px solid #858c97;width:30%;">
                                <t t-if="o.deceased_id.is_administrative">
                                    <span>شهادة ادارية</span>
                                </t>
                                <t t-else="else">
                                    <t t-if="o.deceased_id.fundamental_supporter_2 == 'injury'">
                                        <span>شهادة وفاء اصابية</span>
                                    </t>
                                    <t t-if="o.deceased_id.fundamental_supporter_2 == 'stress'">
                                        <span>قرار لجنة الاجهاد</span>
                                    </t>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>

            <t t-if="o.member_type == 'dead'">
                <div style="direction:rtl; text-align:right;">
                    <table style="width:100%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:10%;">
                                    <span>اسم المتوفى</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:40%;">
                                    <span t-esc="o.deceased_id.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width:100%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:15%;">
                                    <span>الجهة الرئيسية</span>
                                </td>
                                <td style="padding:2px; border:1px solid #858c97;width:25%;">
                                    <span t-esc="o.deceased_id.tag_id.name"/>
                                </td>
                                <td style="width:10%;">
                                    <span>مكان العمل</span>
                                </td>
                                <td style="padding:2px; border:1px solid #858c97;width:20%;">
                                    <span t-esc="o.deceased_id.work_place_id.name"/>
                                </td>
                                <td style="width:10%;">
                                    <span>الجهة الفرعية</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:20%;">
                                    <span t-esc="o.deceased_id.sub_work_place_id.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width:100%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:10%;">
                                    <span>الوظيفة</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:30%;">
                                    <span t-esc="o.deceased_id.job_id.name"/>
                                </td>
                                <td style="width:15%;">
                                    <span>عدد المستفيدين</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:10%;">
                                    <span t-esc="o.deceased_id.beneficiaries_no"/>
                                </td>
                                <td style="width:20%;">
                                    <span>العدد الذى تم الصرف له</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:10%;">
                                    <span t-esc="o.beneficiaries_no"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width:100%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:18%;">
                                    <span>الرقم القومى للمتوفى</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:20%;">
                                    <span t-esc="o.deceased_id.national_id"/>
                                </td>

                                <td style="width:13%;">
                                    <span>السن عند الوفاة</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:10%;">
                                    <span t-esc="o.deceased_id.age"/>
                                </td>

                                <td style="width:11%;">
                                    <span>تاريـخ الوفاة</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:15%;">
                                    <span t-esc="o.deceased_id.death_date"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-if="o.member_type == 'injured'">
                <div style="direction:rtl; text-align:right;">
                    <table style="width:100%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:10%;">
                                    <span>اسم المصاب</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:40%;">
                                    <span t-esc="o.deceased_id.name"/>
                                </td>
                                <td style="width:10%;">
                                </td>
                                <td style="padding:3px;width:40%;">
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width:100%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:15%;">
                                    <span>الجهة الرئيسية</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:15%;">
                                    <span t-esc="o.deceased_id.tag_id.name"/>
                                </td>
                                <td style="width:10%;">
                                    <span>مكان العمل</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:25%;">
                                    <span t-esc="o.deceased_id.work_place_id.name"/>
                                </td>
                                <td style="width:15%;">
                                    <span>الجهة الفرعية</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:20%;">
                                    <span t-esc="o.deceased_id.sub_work_place_id.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:50%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:10%;">
                                    <span>الوظيفة</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:40%;">
                                    <span t-esc="o.deceased_id.job_id.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="width:70%;margin-bottom:5px;">
                        <tbody>
                            <tr>
                                <td style="width:18%;">
                                    <span>الرقم القومى للمصاب</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:20%;">
                                    <span t-esc="o.deceased_id.national_id"/>
                                </td>

                                <td style="width:18%;">
                                    <span>السن عند الاصابة</span>
                                </td>
                                <td style="padding:3px; border:1px solid #858c97;width:10%;">
                                    <span t-esc="o.deceased_id.age"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>

            <div style="width:100%; background-color:black;height:4px;"/>
        </div>
        <div class="article o_report_layout_standard">
            <t t-raw="0"/>
        </div>
        <div class="footer o_background_footer">
            <div style="text-align:center;">
                <p>Page
                    <span class="page"/>
                    of
                    <span class="topage"/>
                </p>
            </div>
        </div>
    </template>

